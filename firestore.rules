rules_version = '2';

// Regras de segurança do Firestore para o Gym Pro.
// Cole isso em: Firebase Console > Firestore Database > Regras.
//
// O que isso garante: cada pessoa só consegue ler e escrever os
// próprios dados (guardados em /users/{seu-uid}/...). Ninguém
// consegue ver ou alterar dados de outro usuário, mesmo estando
// logado no app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
