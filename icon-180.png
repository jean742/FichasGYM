/* ================================================================
   GYM PRO — style.css
   Design system: Dark Theme premium (padrão Apple Fitness / Hevy)
   Sem frameworks. CSS puro com variáveis (custom properties).
================================================================ */

/* ----------------------------------------------------------------
   1. RESET BÁSICO
---------------------------------------------------------------- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  height: 100%;
  -webkit-tap-highlight-color: transparent;
  overscroll-behavior-y: none;
}
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; background: none; border: none; }
a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
::-webkit-scrollbar { width: 0; height: 0; }

/* ----------------------------------------------------------------
   2. DESIGN TOKENS (tema escuro = padrão)
---------------------------------------------------------------- */
:root {
  /* Cores base */
  --bg:            #0A0A0C;   /* preto fosco */
  --bg-elev-1:     #131316;   /* cinza bem escuro (cards) */
  --bg-elev-2:     #1C1C21;   /* cinza escuro (inputs, tabs) */
  --bg-elev-3:     #26262D;   /* hover / active state */
  --border:        rgba(255,255,255,0.08);

  --text:          #F5F5F7;
  --text-dim:      #9A9AA3;
  --text-faint:    #5C5C66;

  /* Cor de destaque (azul neon) — pode ser trocada nas configurações */
  --accent:        #3D8BFF;
  --accent-dim:    rgba(61,139,255,0.16);
  --accent-text:   #0A0A0C;

  --success:       #3DFF8C;
  --success-dim:   rgba(61,255,140,0.14);
  --danger:        #FF4D5E;
  --danger-dim:    rgba(255,77,94,0.14);
  --warning:       #FFB13D;

  /* Sombras */
  --shadow-sm:  0 2px 8px rgba(0,0,0,0.35);
  --shadow-md:  0 8px 24px rgba(0,0,0,0.45);
  --shadow-glow: 0 0 0 1px var(--accent-dim), 0 8px 24px rgba(61,139,255,0.20);

  /* Raios */
  --r-sm: 10px;
  --r-md: 16px;
  --r-lg: 22px;
  --r-full: 999px;

  /* Espaçamentos de área segura (iPhone notch / home indicator) */
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);

  --topbar-h: 56px;
  --nav-h: 64px;

  color-scheme: dark;
}

/* Tema claro (alternado via JS: <html data-theme="light">) */
html[data-theme="light"] {
  --bg:            #F4F4F7;
  --bg-elev-1:     #FFFFFF;
  --bg-elev-2:     #ECECF1;
  --bg-elev-3:     #E1E1E8;
  --border:        rgba(0,0,0,0.08);

  --text:          #16161A;
  --text-dim:      #5B5B66;
  --text-faint:    #9A9AA3;

  --shadow-sm:  0 2px 8px rgba(0,0,0,0.06);
  --shadow-md:  0 8px 24px rgba(0,0,0,0.10);

  color-scheme: light;
}

/* ----------------------------------------------------------------
   3. BASE / TIPOGRAFIA
---------------------------------------------------------------- */
body {
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 15px;
  line-height: 1.45;
  overflow-x: hidden;
  transition: background 0.3s ease, color 0.3s ease;
}
h1, h2, h3, h4 { font-weight: 700; letter-spacing: -0.01em; }
h2 { font-size: 20px; }
h3 { font-size: 16px; }
h4 { font-size: 14px; }

.hidden { display: none !important; }

/* ----------------------------------------------------------------
   4. SPLASH SCREEN
---------------------------------------------------------------- */
.splash-screen {
  position: fixed; inset: 0; z-index: 999;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 24px;
  background: radial-gradient(circle at 50% 30%, #14161c 0%, #0A0A0C 70%);
  transition: opacity 0.5s ease, visibility 0.5s ease;
}
.splash-screen.fade-out { opacity: 0; visibility: hidden; pointer-events: none; }
.splash-logo { display: flex; align-items: center; gap: 10px; font-size: 30px; font-weight: 800; letter-spacing: -0.02em; }
.splash-logo-icon { color: var(--accent); filter: drop-shadow(0 0 12px var(--accent)); }
.splash-logo-text strong { color: var(--accent); }
.splash-loader { display: flex; gap: 6px; }
.splash-loader span {
  width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
  animation: pulse-dot 1.1s infinite ease-in-out;
}
.splash-loader span:nth-child(2) { animation-delay: 0.15s; }
.splash-loader span:nth-child(3) { animation-delay: 0.3s; }
@keyframes pulse-dot { 0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; } 40% { transform: scale(1); opacity: 1; } }

/* ----------------------------------------------------------------
   5. TOASTS
---------------------------------------------------------------- */
.toast-container {
  position: fixed; top: calc(var(--safe-top) + 10px); left: 0; right: 0;
  z-index: 900; display: flex; flex-direction: column; align-items: center; gap: 8px;
  pointer-events: none; padding: 0 16px;
}
.toast {
  background: var(--bg-elev-3); color: var(--text);
  padding: 10px 18px; border-radius: var(--r-full);
  box-shadow: var(--shadow-md); border: 1px solid var(--border);
  font-size: 13px; font-weight: 600;
  animation: toast-in 0.25s ease, toast-out 0.25s ease 2.6s forwards;
  max-width: 90vw;
}
.toast.toast-success { border-color: var(--success); color: var(--success); }
.toast.toast-danger { border-color: var(--danger); color: var(--danger); }
@keyframes toast-in { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes toast-out { to { opacity: 0; transform: translateY(-10px); } }

/* ----------------------------------------------------------------
   6. TOPBAR
---------------------------------------------------------------- */
.topbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  height: calc(var(--topbar-h) + var(--safe-top));
  padding-top: var(--safe-top);
  display: flex; align-items: center; justify-content: center;
  background: color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter: blur(16px) saturate(160%);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  border-bottom: 1px solid var(--border);
}
.topbar-title { font-size: 17px; }
.topbar-back, .topbar-action {
  position: absolute; top: calc(var(--safe-top) + 8px);
  width: 40px; height: 40px; border-radius: var(--r-full);
  display: flex; align-items: center; justify-content: center;
  color: var(--text);
}
.topbar-back { left: 8px; }
.topbar-action { right: 8px; font-size: 22px; }

/* ----------------------------------------------------------------
   7. LAYOUT PRINCIPAL
---------------------------------------------------------------- */
.main-content {
  padding: calc(var(--topbar-h) + var(--safe-top) + 16px) 16px calc(var(--nav-h) + var(--safe-bottom) + 24px);
  min-height: 100vh;
}
.screen { display: none; flex-direction: column; gap: 14px; animation: screen-in 0.25s ease; }
.screen.active { display: flex; }
@keyframes screen-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

/* ----------------------------------------------------------------
   8. CARDS
---------------------------------------------------------------- */
.card {
  background: var(--bg-elev-1);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 16px;
  box-shadow: var(--shadow-sm);
}
.card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.card-header h3 { color: var(--text); }

.badge {
  font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: var(--r-full);
  background: var(--bg-elev-2); color: var(--text-dim);
}
.badge-accent { background: var(--accent-dim); color: var(--accent); }

/* ----------------------------------------------------------------
   9. TELA INÍCIO — PERFIL
---------------------------------------------------------------- */
.profile-card { display: flex; align-items: center; gap: 14px; }
.profile-photo-wrap { position: relative; flex-shrink: 0; }
.profile-photo {
  width: 64px; height: 64px; border-radius: var(--r-full); object-fit: cover;
  border: 2px solid var(--accent); background: var(--bg-elev-2);
}
.photo-edit-btn {
  position: absolute; bottom: -2px; right: -2px;
  width: 22px; height: 22px; border-radius: var(--r-full);
  background: var(--accent); color: var(--accent-text);
  font-size: 11px; display: flex; align-items: center; justify-content: center;
  border: 2px solid var(--bg-elev-1);
}
.profile-info { flex: 1; min-width: 0; }
.profile-name { font-size: 17px; }
.profile-goal { color: var(--text-dim); font-size: 13px; margin-top: 2px; }
.profile-stats-row { display: flex; gap: 16px; margin-top: 8px; }
.profile-stat { display: flex; flex-direction: column; }
.profile-stat span { font-weight: 700; font-size: 14px; }
.profile-stat label { font-size: 11px; color: var(--text-faint); }

/* Barra de progresso */
.progress-bar-track {
  height: 10px; border-radius: var(--r-full); background: var(--bg-elev-2); overflow: hidden;
}
.progress-bar-fill {
  height: 100%; border-radius: var(--r-full);
  background: linear-gradient(90deg, var(--accent), var(--success));
  transition: width 0.6s cubic-bezier(.22,1,.36,1);
}
.progress-caption { font-size: 12px; color: var(--text-dim); margin-top: 8px; }

/* Grade de estatísticas */
.stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.stat-tile {
  background: var(--bg-elev-1); border: 1px solid var(--border); border-radius: var(--r-md);
  padding: 14px; display: flex; flex-direction: column; gap: 2px;
  box-shadow: var(--shadow-sm);
}
.stat-icon { font-size: 18px; margin-bottom: 4px; }
.stat-value { font-size: 19px; font-weight: 800; }
.stat-label { font-size: 11px; color: var(--text-faint); }

.last-workout-empty { color: var(--text-dim); font-size: 13px; }

/* ----------------------------------------------------------------
   10. BOTÕES
---------------------------------------------------------------- */
.btn-primary {
  background: var(--accent); color: var(--accent-text);
  font-weight: 700; border-radius: var(--r-md); padding: 12px 18px;
  box-shadow: var(--shadow-glow);
  transition: transform 0.15s ease, filter 0.15s ease;
}
.btn-primary:active { transform: scale(0.97); filter: brightness(0.95); }
.btn-large { width: 100%; font-size: 15px; padding: 15px; border-radius: var(--r-md); }
.btn-start { position: sticky; bottom: 4px; }

.btn-secondary {
  background: var(--bg-elev-2); color: var(--text); font-weight: 600;
  border-radius: var(--r-md); padding: 12px 16px; border: 1px solid var(--border);
  transition: background 0.15s ease;
}
.btn-secondary:active { background: var(--bg-elev-3); }
.btn-block { width: 100%; margin-top: 8px; text-align: center; }

.btn-danger {
  background: var(--danger-dim); color: var(--danger); font-weight: 700;
  border-radius: var(--r-md); padding: 12px 16px; border: 1px solid transparent;
}

.btn-icon-round {
  width: 38px; height: 38px; border-radius: var(--r-full);
  background: var(--bg-elev-2); color: var(--text);
  display: flex; align-items: center; justify-content: center; font-size: 18px;
  flex-shrink: 0;
}
.btn-icon-round.small { width: 30px; height: 30px; font-size: 15px; }
.btn-icon-round:active { background: var(--bg-elev-3); }

/* ----------------------------------------------------------------
   11. TELA TREINOS
---------------------------------------------------------------- */
.weekday-tabs {
  display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px;
}
.weekday-tab {
  flex: 1; min-width: 44px; padding: 10px 0; text-align: center;
  border-radius: var(--r-md); background: var(--bg-elev-1); border: 1px solid var(--border);
  font-size: 12px; font-weight: 700; color: var(--text-dim);
  transition: all 0.15s ease;
}
.weekday-tab.active { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }

.workout-day-header { display: flex; gap: 8px; align-items: center; }
.workout-day-name-input {
  flex: 1; background: var(--bg-elev-1); border: 1px solid var(--border);
  border-radius: var(--r-md); padding: 12px 14px; color: var(--text); font-weight: 600;
}
.workout-day-name-input::placeholder { color: var(--text-faint); font-weight: 400; }

.exercise-list { display: flex; flex-direction: column; gap: 10px; }

.exercise-card {
  background: var(--bg-elev-1); border: 1px solid var(--border); border-radius: var(--r-lg);
  padding: 14px; box-shadow: var(--shadow-sm);
}
.exercise-card-header { display: flex; align-items: center; gap: 12px; }
.exercise-card-thumb {
  width: 46px; height: 46px; border-radius: var(--r-sm); object-fit: cover;
  background: var(--bg-elev-2); flex-shrink: 0;
}
.exercise-card-title { flex: 1; min-width: 0; }
.exercise-card-title strong { display: block; font-size: 14px; }
.exercise-card-title span { font-size: 11px; color: var(--text-faint); }
.exercise-card-drag { color: var(--text-faint); font-size: 18px; }

.series-mini-list { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
.series-mini-row {
  display: grid; grid-template-columns: 26px 1fr 1fr 1fr 26px; gap: 6px; align-items: center;
}
.series-mini-row input[type="number"] {
  width: 100%; background: var(--bg-elev-2); border: 1px solid var(--border);
  border-radius: 8px; padding: 8px 6px; text-align: center; color: var(--text); font-size: 13px;
}
.series-check {
  width: 24px; height: 24px; border-radius: 7px; border: 2px solid var(--text-faint);
  display: flex; align-items: center; justify-content: center; font-size: 13px; color: transparent;
  transition: all 0.15s ease;
}
.series-check.checked { background: var(--success); border-color: var(--success); color: #0A0A0C; }

.empty-state {
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  padding: 40px 20px; color: var(--text-dim); text-align: center;
}
.empty-state-icon { font-size: 34px; }

/* ----------------------------------------------------------------
   12. TELA PROGRESSO
---------------------------------------------------------------- */
.chart-tabs { display: flex; gap: 8px; overflow-x: auto; }
.chart-tab {
  white-space: nowrap; padding: 9px 14px; border-radius: var(--r-full);
  background: var(--bg-elev-1); border: 1px solid var(--border); font-size: 12.5px;
  color: var(--text-dim); font-weight: 600;
}
.chart-tab.active { background: var(--accent-dim); color: var(--accent); border-color: var(--accent); }

.chart-card { position: relative; }
.chart-card canvas { width: 100%; height: 220px; }
.chart-empty-msg { text-align: center; color: var(--text-faint); font-size: 13px; padding: 60px 10px; }

.stats-list { display: flex; flex-direction: column; }
.stats-row {
  display: flex; justify-content: space-between; padding: 10px 0;
  border-bottom: 1px solid var(--border); font-size: 13.5px; color: var(--text-dim);
}
.stats-row:last-child { border-bottom: none; }
.stats-row strong { color: var(--text); }

/* ----------------------------------------------------------------
   13. TELA CALENDÁRIO
---------------------------------------------------------------- */
.calendar-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.calendar-weekdays {
  display: grid; grid-template-columns: repeat(7, 1fr); text-align: center;
  font-size: 11px; color: var(--text-faint); margin-bottom: 6px; font-weight: 700;
}
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.calendar-day {
  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
  border-radius: 10px; font-size: 12.5px; color: var(--text-dim); position: relative;
  background: var(--bg-elev-2);
}
.calendar-day.empty { background: transparent; }
.calendar-day.trained { background: var(--success-dim); color: var(--success); font-weight: 700; }
.calendar-day.missed { background: var(--danger-dim); color: var(--danger); }
.calendar-day.future { color: var(--text-faint); }
.calendar-day.today { box-shadow: 0 0 0 2px var(--accent) inset; }

.calendar-legend { display: flex; gap: 14px; margin-top: 14px; font-size: 11.5px; color: var(--text-dim); flex-wrap: wrap; }
.dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-right: 5px; }
.dot-trained { background: var(--success); }
.dot-missed { background: var(--danger); }
.dot-future { background: var(--text-faint); }

.streak-display { font-size: 22px; font-weight: 800; }

/* ----------------------------------------------------------------
   14. TELA CONFIGURAÇÕES
---------------------------------------------------------------- */
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
.field span { font-size: 12.5px; color: var(--text-dim); font-weight: 600; }
.field input, .field select {
  background: var(--bg-elev-2); border: 1px solid var(--border); border-radius: var(--r-sm);
  padding: 11px 12px; color: var(--text); font-size: 14px;
}
.field-row { flex-direction: row; align-items: center; justify-content: space-between; }
.field-row span { margin: 0; }

.segmented { display: flex; background: var(--bg-elev-2); border-radius: var(--r-full); padding: 3px; }
.segmented-btn { padding: 7px 14px; border-radius: var(--r-full); font-size: 12.5px; font-weight: 600; color: var(--text-dim); }
.segmented-btn.active { background: var(--accent); color: var(--accent-text); }

.color-swatches { display: flex; gap: 8px; }
.swatch { width: 26px; height: 26px; border-radius: 50%; border: 2px solid transparent; }
.swatch.active { border-color: var(--text); }

.about-text { font-size: 12.5px; color: var(--text-dim); line-height: 1.7; }

/* ----------------------------------------------------------------
   14b. GERADOR AUTOMÁTICO DE FICHA DE TREINO
---------------------------------------------------------------- */
.generator-card {
  background: linear-gradient(135deg, var(--accent-dim), transparent 70%);
  border-color: var(--accent);
}
.generator-desc { font-size: 13px; color: var(--text-dim); line-height: 1.6; margin-bottom: 6px; }
.field-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.field-pair .field { margin-bottom: 12px; }
.generator-error {
  color: var(--danger); font-size: 12.5px; font-weight: 600; text-align: center;
}
#gen-days.weekday-tabs .weekday-tab { cursor: pointer; }
.empty-state .btn-primary { margin-top: 4px; }
.segmented-wide { width: 100%; }
.segmented-wide .segmented-btn { flex: 1; text-align: center; padding: 10px 6px; font-size: 13px; }

/* ----------------------------------------------------------------
   15. MENU INFERIOR
---------------------------------------------------------------- */
.bottom-nav {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 200;
  height: calc(var(--nav-h) + var(--safe-bottom));
  padding-bottom: var(--safe-bottom);
  display: flex; justify-content: space-around; align-items: center;
  background: color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter: blur(16px) saturate(160%);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  border-top: 1px solid var(--border);
}
.nav-btn {
  display: flex; flex-direction: column; align-items: center; gap: 3px;
  color: var(--text-faint); font-size: 10.5px; font-weight: 600; flex: 1;
  padding: 6px 0; transition: color 0.15s ease, transform 0.15s ease;
}
.nav-btn svg { transition: transform 0.15s ease; }
.nav-btn.active { color: var(--accent); }
.nav-btn.active svg { transform: translateY(-1px); }

/* ----------------------------------------------------------------
   16. MODAIS (bottom sheets)
---------------------------------------------------------------- */
.modal {
  position: fixed; inset: 0; z-index: 500;
  display: flex; align-items: flex-end; justify-content: center;
  background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);
  transition: opacity 0.25s ease;
}
.modal.hidden { display: none; }
.modal-sheet {
  width: 100%; max-width: 560px; max-height: 88vh;
  background: var(--bg-elev-1); border-radius: 24px 24px 0 0;
  padding: 10px 18px calc(18px + var(--safe-bottom));
  overflow-y: auto; box-shadow: 0 -8px 30px rgba(0,0,0,0.5);
  animation: sheet-up 0.3s cubic-bezier(.22,1,.36,1);
  display: flex; flex-direction: column; gap: 14px;
}
.modal-sheet-full { min-height: 60vh; }
.modal-sheet-center {
  max-width: 380px; border-radius: 24px; margin-bottom: 10vh;
  align-items: center; text-align: center;
}
@keyframes sheet-up { from { transform: translateY(40px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.modal-handle { width: 40px; height: 4px; border-radius: var(--r-full); background: var(--bg-elev-3); margin: 0 auto; }
.modal-header { display: flex; align-items: center; justify-content: space-between; }
.modal-close {
  width: 32px; height: 32px; border-radius: var(--r-full); background: var(--bg-elev-2);
  display: flex; align-items: center; justify-content: center; font-size: 14px;
}

.search-input {
  width: 100%; background: var(--bg-elev-2); border: 1px solid var(--border);
  border-radius: var(--r-md); padding: 12px 14px; color: var(--text); font-size: 14px;
}
.filter-row { display: flex; gap: 8px; }
.filter-row select {
  flex: 1; background: var(--bg-elev-2); border: 1px solid var(--border);
  border-radius: var(--r-sm); padding: 9px 8px; color: var(--text-dim); font-size: 12.5px;
}

.library-results { display: flex; flex-direction: column; gap: 8px; overflow-y: auto; }
.library-item {
  display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: var(--r-md);
  background: var(--bg-elev-2);
}
.library-item img { width: 44px; height: 44px; border-radius: 10px; object-fit: cover; background: var(--bg-elev-3); }
.library-item-info strong { display: block; font-size: 13.5px; }
.library-item-info span { font-size: 11px; color: var(--text-faint); }
.library-item-add {
  margin-left: auto; width: 30px; height: 30px; border-radius: var(--r-full);
  background: var(--accent); color: var(--accent-text); font-size: 16px;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

/* Detalhe do exercício */
.ex-media { position: relative; border-radius: var(--r-md); overflow: hidden; background: var(--bg-elev-2); flex-shrink: 0; }
.btn-youtube {
  position: absolute; bottom: 10px; right: 10px; background: rgba(0,0,0,0.65); color: #fff;
  padding: 7px 12px; border-radius: var(--r-full); font-size: 12px; font-weight: 700;
  backdrop-filter: blur(4px);
}
.ex-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.tag { background: var(--bg-elev-2); color: var(--text-dim); font-size: 11px; font-weight: 600; padding: 5px 10px; border-radius: var(--r-full); }
.ex-desc { font-size: 13.5px; color: var(--text-dim); line-height: 1.6; }

.ex-accordion details {
  border-top: 1px solid var(--border); padding: 10px 0; font-size: 13px; color: var(--text-dim);
}
.ex-accordion summary { color: var(--text); font-weight: 600; cursor: pointer; }
.ex-accordion p { margin-top: 8px; line-height: 1.6; }
.qrcode-box { display: flex; justify-content: center; padding: 10px; }
.qrcode-box canvas, .qrcode-box svg { background: #fff; border-radius: 8px; padding: 8px; }

.series-block { border-top: 1px solid var(--border); padding-top: 12px; }
.series-list { display: flex; flex-direction: column; gap: 8px; }
.series-item {
  display: grid; grid-template-columns: 30px 1fr 1fr 1fr 30px; gap: 8px; align-items: center;
  background: var(--bg-elev-2); padding: 8px; border-radius: 10px;
}
.series-item label { font-size: 10px; color: var(--text-faint); display: block; text-align: center; }
.series-item input {
  width: 100%; background: var(--bg-elev-1); border: 1px solid var(--border); border-radius: 7px;
  padding: 6px 4px; text-align: center; color: var(--text); font-size: 13px;
}

/* ----------------------------------------------------------------
   17. CRONÔMETRO
---------------------------------------------------------------- */
.timer-circle-wrap { position: relative; width: 220px; height: 220px; margin: 10px auto; }
.timer-svg { width: 100%; height: 100%; transform: rotate(-90deg); }
.timer-track { fill: none; stroke: var(--bg-elev-2); stroke-width: 10; }
.timer-progress {
  fill: none; stroke: var(--accent); stroke-width: 10; stroke-linecap: round;
  stroke-dasharray: 565.48; stroke-dashoffset: 0;
  transition: stroke-dashoffset 1s linear, stroke 0.3s ease;
  filter: drop-shadow(0 0 8px var(--accent));
}
.timer-progress.warning { stroke: var(--warning); filter: drop-shadow(0 0 8px var(--warning)); }
.timer-progress.finished { stroke: var(--success); filter: drop-shadow(0 0 8px var(--success)); }
.timer-display {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  font-size: 36px; font-weight: 800; font-variant-numeric: tabular-nums;
}
.timer-presets { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
.timer-preset {
  padding: 8px 12px; border-radius: var(--r-full); background: var(--bg-elev-2);
  font-size: 12.5px; font-weight: 700; color: var(--text-dim);
}
.timer-preset.active { background: var(--accent); color: var(--accent-text); }
.timer-controls { display: flex; align-items: center; gap: 12px; width: 100%; }
.timer-toggle-btn { flex: 1; }

/* ----------------------------------------------------------------
   18. OVERLAYS (celebração / recorde)
---------------------------------------------------------------- */
.overlay {
  position: fixed; inset: 0; z-index: 700;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.7); backdrop-filter: blur(6px);
}
.overlay.hidden { display: none; }
.complete-card, .record-card {
  background: var(--bg-elev-1); border-radius: 26px; padding: 34px 28px;
  text-align: center; max-width: 320px; box-shadow: var(--shadow-md);
  animation: pop-in 0.4s cubic-bezier(.34,1.56,.64,1);
  border: 1px solid var(--border);
}
@keyframes pop-in { from { transform: scale(0.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.complete-icon, .record-icon { font-size: 54px; margin-bottom: 10px; animation: bounce 0.9s ease infinite; }
@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
.complete-card h2, .record-card h2 { margin-bottom: 8px; }
.complete-card p, .record-card .record-detail { color: var(--text-dim); font-size: 13.5px; margin-bottom: 18px; }
.record-sub { color: var(--success); font-size: 12.5px; font-weight: 600; margin-top: -10px; margin-bottom: 0 !important; }

.overlay-record { pointer-events: none; }
.overlay-record .record-card { border: 1px solid var(--success); box-shadow: 0 0 40px rgba(61,255,140,0.25); }

/* ----------------------------------------------------------------
   18b. PICTOGRAMAS DE EXERCÍCIO (ícones animados SVG)
   Substituem fotos/GIFs de terceiros por ilustrações originais e
   100% offline do padrão de movimento de cada exercício.
---------------------------------------------------------------- */
.pictogram-thumb, .pictogram-detail {
  display: flex; align-items: center; justify-content: center;
  background: var(--bg-elev-2);
}
.pictogram-thumb { border-radius: var(--r-sm); overflow: hidden; }
.pictogram-detail {
  width: 100%; height: 170px; border-radius: var(--r-md);
  background: radial-gradient(circle at 50% 30%, var(--accent-dim), var(--bg-elev-2) 75%);
}
.pictogram-svg {
  width: 100%; height: 100%; color: var(--accent);
  overflow: visible;
}
.pictogram-thumb .pictogram-svg { padding: 4px; }
.pg-line {
  stroke: currentColor; stroke-width: 6; stroke-linecap: round; fill: none;
}
.pg-fill { fill: currentColor; }
.pg-dim { opacity: 0.35; }

.pg-rotate {
  animation: pgSwing 1.35s ease-in-out infinite;
  transform: rotate(var(--a0, 0deg));
}
@keyframes pgSwing {
  0%, 100% { transform: rotate(var(--a0, 0deg)); }
  50% { transform: rotate(var(--a1, 20deg)); }
}

.pg-bob {
  animation: pgBob 1.1s ease-in-out infinite;
  transform: translateY(var(--t0, 0px)) scaleY(var(--s0, 1));
}
@keyframes pgBob {
  0%, 100% { transform: translateY(var(--t0, 0px)) scaleY(var(--s0, 1)); }
  50% { transform: translateY(var(--t1, 10px)) scaleY(var(--s1, 0.95)); }
}

@media (prefers-reduced-motion: reduce) {
  .pg-rotate, .pg-bob { animation: none; }
}

/* ----------------------------------------------------------------
   19. ACESSIBILIDADE / RESPONSIVO
---------------------------------------------------------------- */
button:focus-visible, input:focus-visible, select:focus-visible, [tabindex]:focus-visible {
  outline: 2px solid var(--accent); outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

@media (min-width: 600px) {
  .main-content { max-width: 560px; margin: 0 auto; }
  .topbar, .bottom-nav { max-width: 560px; left: 50%; transform: translateX(-50%); }
}
